# Copy to .env and fill in. .env is gitignored — never commit a real value.
#
# Use Neon's POOLED connection string, the one whose host contains "-pooler".
# Cloud Run scales horizontally, and direct connections will exhaust Postgres's
# connection limit under trivial load.
#
# Note sslmode=verify-full, not the sslmode=require Neon hands you. pg treats
# `require` as `verify-full` today, but in pg v9 it adopts libpq semantics,
# where `require` encrypts without verifying the certificate or hostname. That
# would silently downgrade a verified connection to an unauthenticated one on a
# routine dependency bump. Being explicit costs nothing and survives the change.
DATABASE_URL=postgres://user:password@ep-example-pooler.eu-west-2.aws.neon.tech/beanstalk?sslmode=verify-full
