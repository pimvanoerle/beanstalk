# Copy to .env and fill in. .env is gitignored — never commit a real value.
#
# Use Neon's POOLED connection string, the one whose host contains "-pooler".
# Cloud Run scales horizontally, and direct connections will exhaust Postgres's
# connection limit under trivial load.
DATABASE_URL=postgres://user:password@ep-example-pooler.eu-west-2.aws.neon.tech/beanstalk?sslmode=require
